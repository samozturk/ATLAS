# Application
ATLAS_APP_NAME=ATLAS
ATLAS_ENVIRONMENT=development
ATLAS_LOG_LEVEL=INFO

# HTTP server
ATLAS_HOST=0.0.0.0
ATLAS_PORT=8000

# Local LLM (Ollama)
ATLAS_OLLAMA_BASE_URL=http://localhost:11434
ATLAS_FAST_MODEL=qwen3.6:35b
ATLAS_DEEP_MODEL=qwen3.5:122b-a10b
ATLAS_LLM_CONNECT_TIMEOUT_SECONDS=5
ATLAS_LLM_REQUEST_TIMEOUT_SECONDS=120
ATLAS_LLM_MAX_RETRIES=2
ATLAS_LLM_RETRY_BACKOFF_SECONDS=0.25
ATLAS_AGENT_MAX_TOOL_ROUNDS=3
ATLAS_TOOL_EXECUTION_TIMEOUT_SECONDS=10

# SQLite file for local conversation history and tool audit records.
ATLAS_DATABASE_PATH=data/atlas.db

# Personal-memory review runs locally after a conversation has been idle for
# five minutes. It only retains explicit, durable user facts in the Memory view.
ATLAS_MEMORY_IDLE_SECONDS=300
ATLAS_MEMORY_SCAN_INTERVAL_SECONDS=60
ATLAS_MEMORY_MAX_FACTS_PER_CONVERSATION=8

# Direct local runs: absolute path to the Obsidian vault. Docker overrides the
# in-container path and uses ATLAS_OBSIDIAN_HOST_VAULT_PATH for its bind mount.
ATLAS_OBSIDIAN_VAULT_PATH=/Users/sam/Documents/Obsidian Vault
ATLAS_OBSIDIAN_HOST_VAULT_PATH=/Users/sam/Documents/Obsidian Vault
# Set both values only after you want ATLAS to create or replace notes.
ATLAS_OBSIDIAN_WRITE_ENABLED=false
ATLAS_OBSIDIAN_MOUNT_MODE=ro

# Optional, read-only home-event intake. Leave disabled until the broker and
# device topic contract are ready. ATLAS never publishes device commands here.
ATLAS_MQTT_ENABLED=false
ATLAS_MQTT_HOST=
ATLAS_MQTT_PORT=1883
ATLAS_MQTT_USERNAME=
ATLAS_MQTT_PASSWORD=
ATLAS_MQTT_CLIENT_ID=atlas
ATLAS_MQTT_TOPIC_FILTER=atlas/events/#
ATLAS_MQTT_EVENT_TOPIC_PREFIX=atlas/events
ATLAS_MQTT_RECONNECT_DELAY_SECONDS=5
ATLAS_MQTT_MAX_PAYLOAD_BYTES=32768

# Weather without a named location uses ATLAS's hardcoded Waalwijk home.
# A location named in a user request is geocoded for that request.
ATLAS_WEATHER_REQUEST_TIMEOUT_SECONDS=5
ATLAS_WEATHER_CACHE_TTL_SECONDS=600
