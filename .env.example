# Application
ATLAS_APP_NAME=ATLAS
ATLAS_ENVIRONMENT=development
ATLAS_LOG_LEVEL=INFO

# HTTP server
ATLAS_HOST=0.0.0.0
ATLAS_PORT=8000

# Local LLM (Ollama)
ATLAS_OLLAMA_BASE_URL=http://localhost:11434
ATLAS_FAST_MODEL=qwen3.6:35b-a3b
ATLAS_DEEP_MODEL=qwen3.5:122b-a10b
ATLAS_LLM_CONNECT_TIMEOUT_SECONDS=5
ATLAS_LLM_REQUEST_TIMEOUT_SECONDS=120
ATLAS_LLM_MAX_RETRIES=2
ATLAS_LLM_RETRY_BACKOFF_SECONDS=0.25
ATLAS_AGENT_MAX_TOOL_ROUNDS=3
ATLAS_TOOL_EXECUTION_TIMEOUT_SECONDS=10
